# See https://help.github.com/articles/ignoring-files/

# Dependencies
node_modules/

# Yarn PnP (only if enabled — this repo uses npm + package-lock.json)
.pnp
.pnp.*

# Test & coverage
coverage/

# Next.js
.next/
out/

# Production build
build/

# OS, editor, local junk
.DS_Store
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Secrets & local env (keep `.env.example` committed as a template if you add one)
.env
.env*.local

# Vercel
.vercel

# TypeScript (Next.js generates this — do not hand-edit)
*.tsbuildinfo
next-env.d.ts
